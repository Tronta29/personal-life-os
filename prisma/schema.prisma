// Personal Life OS — Prisma şeması (Neon / PostgreSQL)
// Alan adları kasıtlı olarak snake_case: API JSON çıktısı ve frontend ile birebir uyumlu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransactionType {
  INCOME
  EXPENSE
}

model RoutineProfile {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(50)
  is_active  Boolean   @default(false)
  created_at DateTime  @default(now())
  routines   Routine[]

  @@map("routine_profiles")
}

model Routine {
  id          String              @id @default(uuid()) @db.Uuid
  title       String              @db.VarChar(255)
  description String?
  profile_id  String?             @db.Uuid
  order_index Int                 @default(0)
  is_active   Boolean             @default(true)
  created_at  DateTime            @default(now())
  profile     RoutineProfile?     @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  completions RoutineCompletion[]

  @@map("routines")
}

model RoutineCompletion {
  id             String    @id @default(uuid()) @db.Uuid
  routine_id     String    @db.Uuid
  completed_date DateTime  @db.Date
  is_completed   Boolean   @default(false)
  completed_at   DateTime?
  created_at     DateTime  @default(now())
  routine        Routine   @relation(fields: [routine_id], references: [id], onDelete: Cascade)

  @@unique([routine_id, completed_date])
  @@map("routine_completions")
}

model Project {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(100)
  description  String?
  color        String               @default("#3182ce") @db.VarChar(7)
  status       String               @default("ACTIVE") @db.VarChar(20)
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt
  tasks        Task[]
  transactions FinanceTransaction[]
  notes        Note[]
  goals        Goal[]

  @@map("projects")
}

model Task {
  id               String            @id @default(uuid()) @db.Uuid
  project_id       String?           @db.Uuid
  title            String            @db.VarChar(255)
  description      String?
  status           TaskStatus        @default(TODO)
  priority         TaskPriority      @default(MEDIUM)
  category         String            @default("Kişisel") @db.VarChar(50)
  start_time       DateTime?
  end_time         DateTime?
  cancelled_reason String?
  postponed_count  Int               @default(0)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  project          Project?          @relation(fields: [project_id], references: [id], onDelete: SetNull)
  pomodoros        PomodoroSession[]

  @@map("tasks")
}

model PomodoroSession {
  id               String    @id @default(uuid()) @db.Uuid
  task_id          String?   @db.Uuid
  duration_minutes Int       @default(25)
  break_minutes    Int       @default(5)
  completed        Boolean   @default(false)
  started_at       DateTime?
  ended_at         DateTime?
  created_at       DateTime  @default(now())
  task             Task?     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("pomodoro_sessions")
}

model FinanceCategory {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String               @unique @db.VarChar(50)
  monthly_budget_limit Decimal              @default(0.00) @db.Decimal(12, 2)
  color                String               @default("#718096") @db.VarChar(7)
  transactions         FinanceTransaction[]

  @@map("finance_categories")
}

model FinanceTransaction {
  id               String           @id @default(uuid()) @db.Uuid
  project_id       String?          @db.Uuid
  category_id      String?          @db.Uuid
  type             TransactionType
  amount           Decimal          @db.Decimal(12, 2)
  currency         String           @default("TRY") @db.VarChar(10)
  description      String?
  client_name      String?          @db.VarChar(100)
  is_paid          Boolean          @default(true)
  payment_method   String           @default("CASH") @db.VarChar(20)
  transaction_date DateTime         @default(now()) @db.Date
  created_at       DateTime         @default(now())
  project          Project?         @relation(fields: [project_id], references: [id], onDelete: SetNull)
  category         FinanceCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@map("finance_transactions")
}

model Note {
  id           String   @id @default(uuid()) @db.Uuid
  project_id   String?  @db.Uuid
  title        String?  @db.VarChar(255)
  content      String
  is_organized Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  project      Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@map("notes")
}

model WeeklyScore {
  id                 String   @id @default(uuid()) @db.Uuid
  week_start         DateTime @unique @db.Date
  routines_total     Int      @default(0)
  routines_completed Int      @default(0)
  tasks_total        Int      @default(0)
  tasks_completed    Int      @default(0)
  score_percent      Decimal  @default(0.00) @db.Decimal(5, 2)
  ai_summary         String?
  created_at         DateTime @default(now())

  @@map("weekly_scores")
}

// ===== Hedefler =====
model Goal {
  id            String    @id @default(uuid()) @db.Uuid
  title         String    @db.VarChar(255)
  description   String?
  type          String    @default("NUMERIC") @db.VarChar(20) // NUMERIC, BOOLEAN, DATE
  status        String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, COMPLETED, CANCELLED
  target_value  Float?
  current_value Float     @default(0)
  target_date   DateTime?
  project_id    String?   @db.Uuid
  project       Project?  @relation(fields: [project_id], references: [id], onDelete: SetNull)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("goals")
}

// ===== Alışkanlıklar =====
model Habit {
  id                  String     @id @default(uuid()) @db.Uuid
  title               String     @db.VarChar(255)
  description         String?
  current_streak      Int        @default(0)
  longest_streak      Int        @default(0)
  last_completed_date DateTime?  @db.Date
  is_active           Boolean    @default(true)
  created_at          DateTime   @default(now())
  logs                HabitLog[]

  @@map("habits")
}

model HabitLog {
  id             String   @id @default(uuid()) @db.Uuid
  habit_id       String   @db.Uuid
  habit          Habit    @relation(fields: [habit_id], references: [id], onDelete: Cascade)
  completed_date DateTime @db.Date
  created_at     DateTime @default(now())

  @@unique([habit_id, completed_date])
  @@map("habit_logs")
}

// ===== Abonelikler =====
model Subscription {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(255)
  amount            Float
  currency          String   @default("TRY") @db.VarChar(10)
  period            String   @default("MONTHLY") @db.VarChar(20) // MONTHLY, YEARLY
  next_billing_date DateTime @db.Date
  auto_add_expense  Boolean  @default(true)
  is_active         Boolean  @default(true)
  category_id       String?  @db.Uuid
  created_at        DateTime @default(now())

  @@map("subscriptions")
}

// ===== Taksitler =====
model Installment {
  id                String   @id @default(uuid()) @db.Uuid
  title             String   @db.VarChar(255)
  total_amount      Float
  installment_count Int
  monthly_amount    Float
  paid_count        Int      @default(0)
  start_date        DateTime @db.Date
  category_id       String?  @db.Uuid
  created_at        DateTime @default(now())

  @@map("installments")
}
